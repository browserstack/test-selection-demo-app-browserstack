# Supply-chain security hardening
# Required by the BrowserStack supply-chain .npmrc audit (Enigma / SC-12282).
# See: https://browserstack.atlassian.net/wiki/spaces/ENG/pages/6091571922/Supply+Chain+Security+Enhancements+Tech+Spec
#
# Keep each comment on its own line: .npmrc has no inline comments, so
# `key=true   # note` sets the value to the whole string "true   # note".

# Block malicious package lifecycle scripts
ignore-scripts=true
# Enforce TLS for registry connections
strict-ssl=true
# Pin exact dependency versions
save-exact=true
# Fail on high+ severity advisories
audit-level=high
# Refuse incompatible Node engines
engine-strict=true
# Preserve npm 7+ peer-dependency resolution
legacy-peer-deps=false
# Wait 7 days before resolving newly published package versions (npm 11.10+)
min-release-age=7
